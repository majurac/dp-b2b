# ─── Uploads ─────────────────────────────────────────────────────────────────
# DEPLOY NOTE: media files are not versioned — directory must exist on server
# before first git pull; use one-time rsync for initial media transfer
uploads/

# ─── WordPress Upgrade Temp ──────────────────────────────────────────────────
upgrade/

# ─── Cache ───────────────────────────────────────────────────────────────────
cache/
litespeed/*
!litespeed/.htaccess

# ─── Plugins ─────────────────────────────────────────────────────────────────
# POLICY: plugins are runtime environment, not source code — never track in git
# Install/manage plugins manually or via WP-CLI on each environment
plugins/*

# Allow controlled custom plugins
!plugins/dp-b2b-quick-order/

# ─── Default themes (not needed in production) ───────────────────────────────
themes/twenty*/

# ─── Theme: devDependencies ──────────────────────────────────────────────────
# Build outputs (style.css, js/theme.min.js) are tracked and deployed
themes/dreampoint-b2b/node_modules/

# ─── Plugin: devDependencies ─────────────────────────────────────────────────
plugins/dp-b2b-quick-order/node_modules/

# ─── Claude Code / MCP session files ────────────────────────────────────────
/.claude/
themes/dreampoint-b2b/.claude/
plugins/dp-b2b-quick-order/.claude/
**/.playwright-mcp/

# ─── Source Maps ─────────────────────────────────────────────────────────────
*.css.map

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
error_log
debug.log
